{
  "name": "riskminer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:storybook && next build",
    "build:app": "next build",
    "build:storybook": "storybook build -o public/storybook --disable-telemetry && npm run build-storybook --workspaces --if-present",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspaces --if-present",
    "storybook": "storybook dev -p 6006",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "theme:add": "node scripts/add-theme.mjs",
    "storybook:all": "concurrently -k -n shadcn,heroui,mui,fluent -c blue,magenta,cyan,green \"storybook dev -p 6006\" \"npm run storybook -w @hacknation/ds-heroui\" \"npm run storybook -w @hacknation/ds-mui\" \"npm run storybook -w @hacknation/ds-fluent\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.179",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.75.0",
    "mammoth": "^1.13.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "reveal.js": "^6.0.2",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-storybook": "^10.6.7",
    "storybook": "^10.6.7",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "latest"
  },
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "design-systems/*"
  ]
}

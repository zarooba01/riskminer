# ── Baza danych (Supabase → Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Klucz sekretny: tylko po stronie serwera (aplikacja czyta i zapisuje tabele rm_* z pominięciem RLS).
SUPABASE_SECRET_KEY=
# Do migracji psql (opcjonalnie):
POSTGRES_URL_NON_POOLING=

# ── Model językowy (Vercel AI Gateway) ───────────────────────────────────────
# Na Vercel uwierzytelnienie działa samo (OIDC). Lokalnie: `vercel env pull` albo własny klucz:
AI_GATEWAY_API_KEY=
# Identyfikator „dostawca/model” z https://ai-gateway.vercel.sh/v1/models — zmiana modelu bez zmian w kodzie.
LLM_MODEL=anthropic/claude-haiku-5.5
# Modele na ekranie „Modele” (po przecinku):
LLM_COMPARE_MODELS=anthropic/claude-haiku-5.5,openai/gpt-6-luna,deepseek/deepseek-v4-flash,mistral/ministral-14b,google/gemini-3.1-flash-lite,alibaba/qwen3.7-flash
# Limit znaków wejścia na wywołanie i budżet jednego porównania (USD):
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_COMPARE_USD=0.5

# ── Źródła publiczne ─────────────────────────────────────────────────────────
# Kopia BZP na czas HackNation (bez limitu). Produkcja: https://ezamowienia.gov.pl
BZP_BASE_URL=https://bzp.cytr.us

# ── Dostęp ───────────────────────────────────────────────────────────────────
# Hasło witryny (puste = witryna otwarta, np. lokalnie). Ustaw w Vercel → Environment Variables.
SITE_PASSWORD=

# Wariant design systemu: default | northern-lights | nature (lista w src/lib/themes.ts)
NEXT_PUBLIC_THEME=default
